{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/boomdrivedev/boomdrive/main/crates/boomdrive-hosted/protocol/v7/to-runner.schema.json",
  "description": "A message a control plane sends a runner, in version 7: the version, the message's own id, and a body of one kind a control plane sends.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "id",
    "body"
  ],
  "properties": {
    "protocol_version": {
      "const": 7
    },
    "id": {
      "$ref": "shared.schema.json#/$defs/message_id"
    },
    "body": {
      "$ref": "#/$defs/body"
    }
  },
  "$defs": {
    "body": {
      "description": "One kind a control plane sends, by its name.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enrolled"
          ],
          "properties": {
            "enrolled": {
              "$ref": "enrollment.schema.json#/$defs/enrolled"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enroll_refused"
          ],
          "properties": {
            "enroll_refused": {
              "$ref": "enrollment.schema.json#/$defs/enroll_refused"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pulled"
          ],
          "properties": {
            "pulled": {
              "$ref": "wants.schema.json#/$defs/pulled"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reported"
          ],
          "properties": {
            "reported": {
              "$ref": "report.schema.json#/$defs/reported"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "terminal_open"
          ],
          "properties": {
            "terminal_open": {
              "$ref": "terminal.schema.json#/$defs/terminal_open"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "terminal_resume"
          ],
          "properties": {
            "terminal_resume": {
              "$ref": "terminal.schema.json#/$defs/terminal_resume"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "terminal_input"
          ],
          "properties": {
            "terminal_input": {
              "$ref": "terminal.schema.json#/$defs/terminal_input"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "terminal_close"
          ],
          "properties": {
            "terminal_close": {
              "$ref": "terminal.schema.json#/$defs/terminal_close"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "message_refused"
          ],
          "properties": {
            "message_refused": {
              "$ref": "shared.schema.json#/$defs/message_refused"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "forge_token_given"
          ],
          "properties": {
            "forge_token_given": {
              "$ref": "forge-token.schema.json#/$defs/forge_token_given"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "forge_token_refused"
          ],
          "properties": {
            "forge_token_refused": {
              "$ref": "forge-token.schema.json#/$defs/forge_token_refused"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "newest_release"
          ],
          "properties": {
            "newest_release": {
              "$ref": "#/$defs/newest_release"
            }
          }
        }
      ]
    },
    "newest_release": {
      "description": "The newest release of the runner the control plane knows, which it sends on a connection once its pulled has answered the hello, where that hello's runner is older. The runner says it and judges nothing of it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "description": "The release's version, as its tag v<version> names it.",
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$"
        }
      }
    }
  }
}
