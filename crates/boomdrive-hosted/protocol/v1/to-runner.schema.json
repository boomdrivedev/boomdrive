{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/agentplot/boomdrive/main/crates/boomdrive-hosted/protocol/v1/to-runner.schema.json",
  "description": "A message a control plane sends a runner, in version 1: the version, the message's own id, and a body of one kind a control plane sends.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "id",
    "body"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "id": {
      "$ref": "shared.schema.json#/$defs/message_id"
    },
    "body": {
      "$ref": "#/$defs/body"
    }
  },
  "$defs": {
    "body": {
      "description": "One kind a control plane sends, by its name.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enrolled"
          ],
          "properties": {
            "enrolled": {
              "$ref": "enrollment.schema.json#/$defs/enrolled"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enroll_refused"
          ],
          "properties": {
            "enroll_refused": {
              "$ref": "enrollment.schema.json#/$defs/enroll_refused"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pulled"
          ],
          "properties": {
            "pulled": {
              "$ref": "wants.schema.json#/$defs/pulled"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reported"
          ],
          "properties": {
            "reported": {
              "$ref": "report.schema.json#/$defs/reported"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "terminal_open"
          ],
          "properties": {
            "terminal_open": {
              "$ref": "terminal.schema.json#/$defs/terminal_open"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "terminal_resume"
          ],
          "properties": {
            "terminal_resume": {
              "$ref": "terminal.schema.json#/$defs/terminal_resume"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "terminal_input"
          ],
          "properties": {
            "terminal_input": {
              "$ref": "terminal.schema.json#/$defs/terminal_input"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "terminal_close"
          ],
          "properties": {
            "terminal_close": {
              "$ref": "terminal.schema.json#/$defs/terminal_close"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "message_refused"
          ],
          "properties": {
            "message_refused": {
              "$ref": "shared.schema.json#/$defs/message_refused"
            }
          }
        }
      ]
    }
  }
}
